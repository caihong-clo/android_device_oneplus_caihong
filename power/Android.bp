cc_library_static {
    name: "power-ext-caihong",
    defaults: ["android.hardware.power-ndk_shared"],
    vendor: true,
    srcs: [
        "power-mode.cpp",
    ],
    header_libs: [
        "qti_powerhal_headers",
        "//hardware/oplus:vendor.oplus.hardware.touch-headers",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
    ],
    whole_static_libs: [
        "//hardware/oplus:vendor.oplus.hardware.touch-V2-ndk",
    ],
}
