cc_library_shared {
    name: "liboplus_spatializer_shim",
    vendor: true,
    relative_install_path: "soundfx",
    srcs: ["SpatializerShim.cpp"],
    shared_libs: ["liblog"],
    header_libs: [
        "libaudio_system_headers",
        "libhardware_headers",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
