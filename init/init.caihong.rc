on fs && property:ro.boot.hardware.revision=CN
    setprop ro.product.marketname "OnePlus Pad Pro"

on fs && property:ro.boot.hardware.revision=GLO
    setprop ro.product.marketname "OnePlus Pad 2"

on property:vendor.post_boot.parsed=1
    # Stock caps the prime cluster like the others. WALT lifts the cap
    # under sustained load or a full throttle boost.
    write /proc/sys/walt/sched_fmax_cap "1804800 2707200 2707200 3187200"

    # Give the foreground more CPU time than background work when busy.
    write /dev/cpuctl/top-app/cpu.shares 5120
    write /dev/cpuctl/foreground/cpu.shares 4096

    # Keep compaction away from mlocked pages. PinnerService locks the
    # framework, SystemUI and launcher code in memory; migrating those
    # pages makes their next access fault in the middle of a frame.
    write /proc/sys/vm/compact_unevictable_allowed 0
